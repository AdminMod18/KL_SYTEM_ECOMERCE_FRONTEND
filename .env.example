# --- Desarrollo (Vite) ---
# Prefijo servido por el proxy: /api → microservicios locales (ver vite.config.js).
VITE_API_URL=/api

# --- Producción (build) ---
# URL absoluta del API Gateway o backend público.
# VITE_API_URL=https://api.midominio.com

# Admin / parametrización (admin-service). Debe terminar en /admin (ej. https://TU_CLOUDFRONT/api/admin).
# Si se omite, se usa VITE_API_URL + /admin automáticamente.
# VITE_ADMIN_URL=https://api.midominio.com/api/admin

# Analytics / BAM (analytics-service). En desarrollo se usa /api/analytics vía proxy Vite.
# VITE_ANALYTICS_URL=/api/analytics

# Timeout HTTP (ms)
VITE_API_TIMEOUT=20000

# Peticiones axios pueden usar { skipGlobalLoading: true } en la config para no sumar al overlay global
# (útil junto a spinners locales, p. ej. listados con skeleton).
